# Configuration for Motorola Moto G200 5G (xpeng, SM8350),
# chainloaded from the stock bootloader (fastboot boot).

#include "qcom_defconfig"
#include "board/qualcomm/qcom-phone.config"

CONFIG_DEFAULT_DEVICE_TREE="qcom/sm8350-motorola-xpeng"
CONFIG_CLK_QCOM_SM8350=y
CONFIG_BOARD_EARLY_INIT_R=y
CONFIG_PREBOOT="run serial_gadget; setenv bootcmd 'echo BOOTOK; run menucmd'"
