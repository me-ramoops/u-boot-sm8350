/ {
	chosen {
		stdout-path = "serial0:115200n8";
	};
};

&gcc {
	bootph-all;
};

&tlmm {
	bootph-all;
};

&uart2 {
	bootph-all;
};

&usb_1 {
	bootph-all;
};

&usb_1_hsphy {
	bootph-all;
};

&usb_1_qmpphy {
	bootph-all;
};

&usb_1_dwc3 {
	bootph-all;
};

&mdss {
	status = "disabled";
};

&rpmhcc {
	bootph-all;
};
